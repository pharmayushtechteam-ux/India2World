# India2World SMTP & Automated Email Configuration
# To send real invoice emails directly from the Admin Panel, configure your SMTP credentials below or via Admin & Operations Settings > Email & SMTP Configuration:

# Common SMTP Configurations:
# ----------------------------------------------------
# 1. Gmail (Recommended):
#    SMTP_HOST=smtp.gmail.com
#    SMTP_PORT=587
#    SMTP_SECURITY=STARTTLS
#    SMTP_SECURE=false
#    SMTP_USER=pharmayushtechteam@gmail.com
#    SMTP_PASS=your-16-character-app-password (generated from https://myaccount.google.com/apppasswords)
#    SMTP_FROM_NAME="India2World Invoicing"
#    SMTP_FROM="India2World Invoicing" <pharmayushtechteam@gmail.com>
#
# 2. Custom SMTP (Hostinger / cPanel / Zoho):
#    SMTP_HOST=smtp.zoho.com
#    SMTP_PORT=465
#    SMTP_SECURITY=SSL
#    SMTP_SECURE=true
#    SMTP_USER=billing@india2world.com
#    SMTP_PASS=your-mailbox-password
# ----------------------------------------------------

SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURITY=STARTTLS
SMTP_SECURE=false
SMTP_USER=pharmayushtechteam@gmail.com
SMTP_PASS=
SMTP_FROM_NAME="India2World Invoicing"
SMTP_FROM="India2World Invoicing" <pharmayushtechteam@gmail.com>
